[Unit]
Description=ERS LoRa packet forwarder (SX1302 concentrator)
After=network.target

[Service]
Type=simple
User=@ERS_USER@
# lora_pkt_fwd runs ./reset_lgw.sh itself, so it must start in the HAL folder.
WorkingDirectory=@HAL_DIR@/packet_forwarder
Environment=ERS_HAL_DIR=@HAL_DIR@
# Reset the concentrator first: a hung SX1302 otherwise never recovers.
ExecStartPre=@ERS_DIR@/server/lora/reset_concentrator.sh
ExecStart=@HAL_DIR@/packet_forwarder/lora_pkt_fwd -c @ERS_DIR@/server/lora/global_conf.json
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
