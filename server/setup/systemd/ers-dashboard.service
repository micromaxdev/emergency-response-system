[Unit]
Description=ERS dashboard (Streamlit, port 8501)
After=network.target

[Service]
Type=simple
User=@ERS_USER@
WorkingDirectory=@ERS_DIR@
EnvironmentFile=-/etc/ers/ers.env
ExecStart=@ERS_DIR@/venv/bin/python -m streamlit run website/web_main.py --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=3
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
